="90" as="geometry"/></mxCell><mxCell id="p2lg" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;White: built today&lt;br&gt;Yellow: in a GitHub issue (#number)&lt;br&gt;Red: GAP, no issue yet&lt;br&gt;Blue: data kept or email sent" style="rounded=1;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="850" y="0" width="400" height="90" as="geometry"/></mxCell><mxCell id="p2lh0" value="&lt;b&gt;Person&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="0" y="110" width="250" height="36" as="geometry"/></mxCell><mxCell id="p2lb0" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="0" y="146" width="250" height="1480" as="geometry"/></mxCell><mxCell id="p2lh1" value="&lt;b&gt;App (phone or laptop)&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="250" y="110" width="250" height="36" as="geometry"/></mxCell><mxCell id="p2lb1" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="250" y="146" width="250" height="1480" as="geometry"/></mxCell><mxCell id="p2lh2" value="&lt;b&gt;Website (browser)&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="500" y="110" width="250" height="36" as="geometry"/></mxCell><mxCell id="p2lb2" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="500" y="146" width="250" height="1480" as="geometry"/></mxCell><mxCell id="p2lh3" value="&lt;b&gt;Server&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="750" y="110" width="250" height="36" as="geometry"/></mxCell><mxCell id="p2lb3" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="750" y="146" width="250" height="1480" as="geometry"/></mxCell><mxCell id="p2lh4" value="&lt;b&gt;Database and email&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="110" width="250" height="36" as="geometry"/></mxCell><mxCell id="p2lb4" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="146" width="250" height="1480" as="geometry"/></mxCell><mxCell id="p2a" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="110.0" y="181.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="p2b" value="Account icon, then &amp;#x27;Sign in&amp;#x27;&lt;br&gt;&lt;b&gt;(#174)&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="275.0" y="264.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p2c" value="Sign in screen: &amp;#x27;Create an account&amp;#x27; opens the browser" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="275.0" y="364.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p2d" value="Sign up page: email, password of 12 or more characters" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="525.0" y="464.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p2e" value="Make the account. Same answer if the email is taken" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="775.0" y="564.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p2e2" value="Account saved. Confirmation email sent" style="rounded=1;html=1;whit