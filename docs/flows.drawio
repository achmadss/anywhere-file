arget="p6e2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6e5" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p6d" target="p6f"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p6f" target="p6g"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p6g" target="p6h"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p6i" target="p6j"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p6j" target="p6k"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p6k" target="p6l"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="8 Take a PC off an account" id="d9"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p7t" value="&lt;b&gt;8. Take a PC off an account&lt;/b&gt;&lt;br&gt;Signing out from the PC works today. A PC that was sold, broken or uninstalled stays on the account for good." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="830" height="90" as="geometry"/></mxCell><mxCell id="p7lg" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;White: built today&lt;br&gt;Yellow: in a GitHub issue (#number)&lt;br&gt;Red: GAP, no issue yet&lt;br&gt;Blue: data kept or email sent" style="rounded=1;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="850" y="0" width="400" height="90" as="geometry"/></mxCell><mxCell id="p7lh0" value="&lt;b&gt;Owner&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="0" y="110" width="250" height="36" as="geometry"/></mxCell><mxCell id="p7lb0" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="0" y="146" width="250" height="1180" as="geometry"/></mxCell><mxCell id="p7lh1" value="&lt;b&gt;PC settings page (browser on the PC)&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="250" y="110" width="250" height="36" as="geometry"/></mxCell><mxCell id="p7lb1" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="250" y="146" width="250" height="1180" as="geometry"/></mxCell><mxCell id="p7lh2" value="&lt;b&gt;Agent (background, on the PC)&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="500" y="110" width="250" height="36" as="geometry"/></mxCell><mxCell id="p7lb2" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="500" y="146" width="250" height="1180" as="geometry"/></mxCell><mxCell id="p7lh3" value="&lt;b&gt;Server&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="750" y="110" width="250" height="36" as="geometry"/></mxCell><mxCell id="p7lb3" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="750" y="146" width="250" height="1180" as="geometry"/></mxCell><mxCell id="p7lh4" value="&lt;b&gt;App (phone or laptop)&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="110" width="250" height="36" as="geometry"/></mxCell><mxCell id="p7lb4" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="146" width="250" height="1180" as="geometry"/></mxCell><mxCell id="p7a" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="110.0" y="181.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="p7b" value="Can you still use the PC?" style="rhombus;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="30.0" y="254.0" width="190" height="84" as="geometry"/></mxCell><mxCell id="p7c" value="Account section: &amp;#x27;Sign out&amp;#x27;" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="275.0" y="364.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p7d" value="Tell the server, signed with the device key. Forget the account" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="525.0" y="464.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p7e" value="Remove the PC from the account for everyone. Close its connection" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="775.0" y="564.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p7f" value="No longer &amp;#x27;Over the internet&amp;#x27;. Still &amp;#x27;On your Wi-Fi&amp;#x27; at home" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1025.0" y="664.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p7g" value="" style="ellipse;shape=doubleEllipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="110.0" y="781.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="p7h" value="Admin&amp;#x27;s card menu: &amp;#x27;Remove from my account&amp;#x27;&lt;br&gt;&lt;b&gt;(#189)&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1025.0" y="864.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p7i" value="Drop the PC from the account. Today only &amp;#x27;disable&amp;#x27; exists: it cannot be undone and the PC still shows&lt;br&gt;&lt;b&gt;(#189)&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="775.0" y="964.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p7j" value="Uninstalling the agent also leaves the PC on the account (#189)" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="525.0" y="1061.0" width="200" height="70" as="geometry"/></mxCell><mxCell id="p7k" value="" style="ellipse;shape=doubleEllipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="110.0" y="1181.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="p7e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p7a" target="p7b"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7e1" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p7b" target="p7c"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p7c" target="p7d"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p7d" target="p7e"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p7e" target="p7f"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p7f" target="p7g"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7e6" value="No: sold, broken, uninstalled" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p7b" target="p7h"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p7h" target="p7i"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p7i" target="p7k"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="9 Forgot the password, or the session ended" id="d10"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p8t" value="&lt;b&gt;9. Forgot the password, or the session ended&lt;/b&gt;&lt;br&gt;The app never handles a reset. It opens the browser." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="830" height="90" as="geometry"/></mxCell><mxCell id="p8lg" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;White: built today&lt;br&gt;Yellow: in a GitHub issue (#number)&lt;br&gt;Red: GAP, no issue yet&lt;br&gt;Blue: data kept or email sent" style="rounded=1;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="850" y="0" width="400" height="90" as="geometry"/></mxCell><mxCell id="p8lh0" value="&lt;b&gt;Person&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="0" y="110" width="250" height="36" as="geometry"/></mxCell><mxCell id="p8lb0" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="0" y="146" width="250" height="1080" as="geometry"/></mxCell><mxCell id="p8lh1" value="&lt;b&gt;App (phone or laptop)&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="250" y="110" width="250" height="36" as="geometry"/></mxCell><mxCell id="p8lb1" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="250" y="146" width="250" height="1080" as="geometry"/></mxCell><mxCell id="p8lh2" value="&lt;b&gt;Website (browser)&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="500" y="110" width="250" height="36" as="geometry"/></mxCell><mxCell id="p8lb2" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="500" y="146" width="250" height="1080" as="geometry"/></mxCell><mxCell id="p8lh3" value="&lt;b&gt;Server&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="750" y="110" width="250" height="36" as="geometry"/></mxCell><mxCell id="p8lb3" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="750" y="146" width="250" height="1080" as="geometry"/></mxCell><mxCell id="p8lh4" value="&lt;b&gt;Database and email&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="110" width="250" height="36" as="geometry"/></mxCell><mxCell id="p8lb4" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="146" width="250" height="1080" as="geometry"/></mxCell><mxCell id="p8a" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="110.0" y="181.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="p8b" value="Sign in screen: &amp;#x27;Forgot your password&amp;#x27;" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="275.0" y="264.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p8c" value="Reset page: email, &amp;#x27;Send the link&amp;#x27;" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="525.0" y="364.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p8d" value="If there is an account, email a link. Same answer either way" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="775.0" y="464.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p8d2" value="Reset email sent" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1030.0" y="468.0" width="190" height="56" as="geometry"/></mxCell><mxCell id="p8e" value="Open the link" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="25.0" y="564.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p8f" value="&amp;#x27;Choose a new password&amp;#x27;, &amp;#x27;Save it&amp;#x27;" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="525.0" y="664.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p8g" value="Change the password and end every open session" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="775.0" y="764.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p8h" value="Next start: dot on the Account icon. &amp;#x27;That session ended. Sign in again.&amp;#x27; PCs on the Wi-Fi keep working&lt;br&gt;&lt;b&gt;(#174)&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="275.0" y="864.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p8i" value="Sign in again (flow 3)" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="275.0" y="964.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p8j" value="" style="ellipse;shape=doubleEllipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="110.0" y="1081.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="p8e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p8a" target="p8b"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p8e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p8b" target="p8c"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p8e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p8c" target="p8d"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p8e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p8d" target="p8e"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p8e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p8e" target="p8f"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p8e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p8f" target="p8g"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p8e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p8g" target="p8h"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p8e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p8h" target="p8i"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p8e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p8i" target="p8j"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p8e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="p8d" target="p8d2"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="10 Update the app and the PC program" id="d11"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p9t" value="&lt;b&gt;10. Update the app and the PC program&lt;/b&gt;&lt;br&gt;No app store, so nothing updates by itself. Each side has to tell the person." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1080" height="90" as="geometry"/></mxCell><mxCell id="p9lg" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;White: built today&lt;br&gt;Yellow: in a GitHub issue (#number)&lt;br&gt;Red: GAP, no issue yet&lt;br&gt;Blue: data kept or email sent" style="rounded=1;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1100" y="0" width="400" height="90" as="geometry"/></mxCell><mxCell id="p9lh0" value="&lt;b&gt;Person&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="0" y="110" width="250" height="36" as="geometry"/></mxCell><mxCell id="p9lb0" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="0" y="146" width="250" height="1480" as="geometry"/></mxCell><mxCell id="p9lh1" value="&lt;b&gt;App (phone or laptop)&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="250" y="110" width="250" height="36" as="geometry"/></mxCell><mxCell id="p9lb1" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="250" y="146" width="250" height="1480" as="geometry"/></mxCell><mxCell id="p9lh2" value="&lt;b&gt;Website (browser)&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="500" y="110" width="250" height="36" as="geometry"/></mxCell><mxCell id="p9lb2" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="500" y="146" width="250" height="1480" as="geometry"/></mxCell><mxCell id="p9lh3" value="&lt;b&gt;Server&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="750" y="110" width="250" height="36" as="geometry"/></mxCell><mxCell id="p9lb3" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="750" y="146" width="250" height="1480" as="geometry"/></mxCell><mxCell id="p9lh4" value="&lt;b&gt;PC settings page (browser on the PC)&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="110" width="250" height="36" as="geometry"/></mxCell><mxCell id="p9lb4" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="146" width="250" height="1480" as="geometry"/></mxCell><mxCell id="p9lh5" value="&lt;b&gt;Agent (background, on the PC)&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1250" y="110" width="250" height="36" as="geometry"/></mxCell><mxCell id="p9lb5" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1250" y="146" width="250" height="1480" as="geometry"/></mxCell><mxCell id="p9a" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="110.0" y="181.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="p9b" value="When Home opens, ask the server for the latest version&lt;br&gt;&lt;b&gt;(#177)&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="275.0" y="264.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p9c" value="Answer from the release it already caches&lt;br&gt;&lt;b&gt;(#177)&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="775.0" y="364.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p9d" value="Newer than this app?" style="rhombus;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="280.0" y="454.0" width="190" height="84" as="geometry"/></mxCell><mxCell id="p9e" value="Banner: &amp;#x27;Version x is available.&amp;#x27; &amp;#x27;Download&amp;#x27;&lt;br&gt;&lt;b&gt;(#177)&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="275.0" y="564.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p9f" value="Download page&lt;br&gt;&lt;b&gt;(#180)&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="525.0" y="664.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p9g" value="Install over the old one. Sign-in and known PCs kept (same signing key)&lt;br&gt;&lt;b&gt;(#172)&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="25.0" y="764.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p9h" value="" style="ellipse;shape=doubleEllipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="110.0" y="881.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="p9i" value="A PC on the Wi-Fi speaks a different version?" style="rhombus;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="280.0" y="954.0" width="190" height="84" as="geometry"/></mxCell><mxCell id="p9j" value="Today the PC is hidden with no word. Show it as &amp;#x27;Needs an update&amp;#x27; instead&lt;br&gt;&lt;b&gt;(#184)&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="275.0" y="1064.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p9k" value="Settings page says the PC program is out of date, with a link to Download&lt;br&gt;&lt;b&gt;(#190)&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1025.0" y="1164.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p9l" value="Run the new installer on the PC" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="25.0" y="1264.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p9m" value="Restarts. Keeps its key, shares and account (to be checked)&lt;br&gt;&lt;b&gt;(#190)&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1275.0" y="1364.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p9n" value="" style="ellipse;shape=doubleEllipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="110.0" y="1481.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="p9e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p9a" target="p9b"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p9e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p9b" target="p9c"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p9e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p9c" target="p9d"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p9e3" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p9d" target="p9e"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p9e4" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p9d" target=