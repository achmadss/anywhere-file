rd right?" style="rhombus;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="780.0" y="654.0" width="190" height="84" as="geometry"/></mxCell><mxCell id="p10h" value="&amp;#x27;invalid password&amp;#x27;" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="525.0" y="764.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p10i" value="Delete the account, its access to every PC and its sessions. PCs and other people untouched" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="775.0" y="864.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p10j" value="&amp;#x27;Your account is deleted.&amp;#x27;&lt;br&gt;&lt;b&gt;(#183)&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="525.0" y="964.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p10k" value="Next start: &amp;#x27;That session ended. Sign in again.&amp;#x27;" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="275.0" y="1064.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p10l" value="" style="ellipse;shape=doubleEllipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="110.0" y="1181.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="p10e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p10a" target="p10b"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p10e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p10b" target="p10c"><mxGeometry relative="1" as="geometry"/></