/root></mxGraphModel></diagram><diagram name="11 Delete an account" id="d12"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p10t" value="&lt;b&gt;11. Delete an account&lt;/b&gt;&lt;br&gt;On the website, so it works without the app installed." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="580" height="90" as="geometry"/></mxCell><mxCell id="p10lg" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;White: built today&lt;br&gt;Yellow: in a GitHub issue (#number)&lt;br&gt;Red: GAP, no issue yet&lt;br&gt;Blue: data kept or email sent" style="rounded=1;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="600" y="0" width="400" height="90" as="geometry"/></mxCell><mxCell id="p10lh0" value="&lt;b&gt;Person&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="0" y="110" width="250" height="36" as="geometry"/></mxCell><mxCell id="p10lb0" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="0" y="146" width="250" height="1180" as="geometry"/></mxCell><mxCell id="p10lh1" value="&lt;b&gt;App (phone or laptop)&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="250" y="110" width="250" height="36" as="geometry"/></mxCell><mxCell id="p10lb1" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="250" y="146" width="250" height="1180" as="geometry"/></mxCell><mxCell id="p10lh2" value="&lt;b&gt;Website (browser)&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="500" y="110" width="250" height="36" as="geometry"/></mxCell><mxCell id="p10lb2" v