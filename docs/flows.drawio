 id="p5e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p5i" target="p5j"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5e9" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p5h" target="p5j"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5e10" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p5j" target="p5k"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p5k" target="p5l"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5e12" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p5j" target="p5l"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p5l" target="p5m"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5e14" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p5m" target="p5n"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p5n" target="p5n2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5e16" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p5m" target="p5o"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="p5o" target="p5o2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p5o" target="p5p"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p5p" target="p5q"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="7 Remove someone, or leave a PC" id="d8"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p6t" value="&lt;b&gt;7. Remove someone, or leave a PC&lt;/b&gt;&lt;br&gt;An admin removes a person. A guest who no longer wants a PC in their list has no way out today." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="830" height="90" as="geometry"/></mxCell><mxCell id="p6lg" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;White: built today&lt;br&gt;Yellow: in a GitHub issue (#number)&lt;br&gt;Red: GAP, no issue yet&lt;br&gt;Blue: data kept or email sent" style="rounded=1;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="850" y="0" width="400" height="90" as="geometry"/></mxCell><mxCell id="p6lh0" value="&lt;b&gt;Admin&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="0" y="110" width="250" height="36" as="geometry"/></mxCell><mxCell id="p6lb0" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="0" y="146" width="250" height="1180" as="geometry"/></mxCell><mxCell id="p6lh1" value="&lt;b&gt;Admin&amp;#x27;s app&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="250" y="110" width="250" height="36" as="geometry"/></mxCell><mxCell id="p6lb1" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="250" y="146" width="250" height="1180" as="geometry"/></mxCell><mxCell id="p6lh2" value="&lt;b&gt;Server&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="500" y="110" width="250" height="36" as="geometry"/></mxCell><mxCell id="p6lb2" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="500" y="146" width="250" height="1180" as="geometry"/></mxCell><mxCell id="p6lh3" value="&lt;b&gt;Guest&amp;#x27;s app&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="750" y="110" width="250" height="36" as="geometry"/></mxCell><mxCell id="p6lb3" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="750" y="146" width="250" height="1180" as="geometry"/></mxCell><mxCell id="p6lh4" value="&lt;b&gt;Guest&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="110" width="250" height="36" as="geometry"/></mxCell><mxCell id="p6lb4" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="146" width="250" height="1180" as="geometry"/></mxCell><mxCell id="p6a" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="110.0" y="181.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="p6b" value="Manage: &amp;#x27;Remove&amp;#x27; next to the person" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="275.0" y="264.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p6c" value="&amp;#x27;Remove ewa@example.com?&amp;#x27; &amp;#x27;They lose access straight away.&amp;#x27; Remove" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="275.0" y="364.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p6d" value="Would this remove the last admin?" style="rhombus;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="530.0" y="454.0" width="190" height="84" as="geometry"/></mxCell><mxCell id="p6e" value="&amp;#x27;a device keeps at least one admin&amp;#x27;" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="275.0" y="564.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p6e2" value="" style="ellipse;shape=doubleEllipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="110.0" y="581.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="p6f" value="Mark the access removed. The next request is refused" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="525.0" y="664.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p6g" value="Next request fails. The PC leaves the list at the next refresh" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="775.0" y="764.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p6h" value="" style="ellipse;shape=doubleEllipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1110.0" y="781.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="p6i" valu