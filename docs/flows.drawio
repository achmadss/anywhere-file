;endFill=1;fontSize=11;" edge="1" parent="1" source="p2g" target="p2h"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p2h" target="p2i"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p2i" target="p2j"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p2j" target="p2k"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="p2e" target="p2e2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2e10" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p2k" target="p2l"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2e11" value="try again" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p2l" target="p2j"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2e12" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p2k" target="p2m"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="p2m" target="p2m2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p2m" target="p2n"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p2n" target="p2o"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="4 Add a PC to an account" id="d5"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p3t" value="&lt;b&gt;4. Add a PC to an account&lt;/b&gt;&lt;br&gt;Done on the PC. Lets the owner reach it over the internet and invite others. The app never adds a PC." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1330" height="90" as="geometry"/></mxCell><mxCell id="p3lg" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;White: built today&lt;br&gt;Yellow: in a GitHub issue (#number)&lt;br&gt;Red: GAP, no issue yet&lt;br&gt;Blue: data kept or email sent" style="rounded=1;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1350" y="0" width="400" height="90" as="geometry"/></mxCell><mxCell id="p3lh0" value="&lt;b&gt;Person&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="0" y="110" width="250" height="36" as="geometry"/></mxCell><mxCell id="p3lb0" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="0" y="146" width="250" height="1980" as="geometry"/></mxCell><mxCell id="p3lh1" value="&lt;b&gt;PC settings page (browser on the PC)&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="250" y="110" width="250" height="36" as="geometry"/></mxCell><mxCell id="p3lb1" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="250" y="146" width="250" height="1980" as="geometry"/></mxCell><mxCell id="p3lh2" value="&lt;b&gt;Agent (background, on the PC)&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="500" y="110" width="250" height="36" as="geometry"/></mxCell><mxCell id="p3lb2" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="500" y="146" width="250" height="1980" as="geometry"/></mxCell><mxCell id="p3lh3" value="&lt;b&gt;Website (browser)&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="750" y="110" width="250" height="36" as="geometry"/></mxCell><mxCell id="p3lb3" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="750" y="146" width="250" height="1980" as="geometry"/></mxCell><mxCell id="p3lh4" value="&lt;b&gt;Server&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="110" width="250" height="36" as="geometry"/></mxCell><mxCell id="p3lb4" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="146" width="250" height="1980" as="geometry"/></mxCell><mxCell id="p3lh5" value="&lt;b&gt;Database and email&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1250" y="110" width="250" height="36" as="geometry"/></mxCell><mxCell id="p3lb5" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1250" y="146" width="250" height="1980" as="geometry"/></mxCell><mxCell id="p3lh6" value="&lt;b&gt;App (phone or laptop)&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1500" y="110" width="250" height="36" as="geometry"/></mxCell><mxCell id="p3lb6" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1500" y="146" width="250" height="1980" as="geometry"/></mxCell><mxCell id="p3a" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="110.0" y="181.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="p3b" value="Account section: &amp;#x27;Sign in&amp;#x27;. Server address built in&lt;br&gt;&lt;b&gt;(#175)&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="275.0" y="264.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p3c" value="Ask the server to start, signed with the device key" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="525.0" y="364.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p3d" value="Make a short code and an approval link" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1025.0" y="464.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p3e" value="Show &amp;#x27;Approve this PC at &amp;lt;link&amp;gt;, where the code is &amp;lt;code&amp;gt;&amp;#x27;, open the link in a new tab" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="275.0" y="564.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p3f" value="Signed in on the website?" style="rhombus;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="780.0" y="654.0" width="190" height="84" as="geometry"/></mxCell><mxCell id="p3g" value="Has an account?" style="rhombus;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="780.0" y="754.0" width="190" height="84" as="geometry"/></mxCell><mxCell id="p3h" value="Links to &amp;#x27;Create an account&amp;#x27; and &amp;#x27;Forgot your password&amp;#x27; that come back to this approval&lt;br&gt;&lt;b&gt;(#186)&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="775.0" y="864.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p3i" value="Sign in form, then the page reloads" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="775.0" y="964.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p3j" value="&amp;#x27;Approve this PC?&amp;#x27; shows the PC&amp;#x27;s name and your email" style="rhombus;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="780.0" y="1054.0" width="190" height="84" as="geometry"/></mxCell><mxCell id="p3k" value="Mark refused" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1025.0" y="1164.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p3k2" value="Shows the refusal. The PC stays as it was" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="275.0" y="1164.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p3k3" value="" style="ellipse;shape=doubleEllipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="110.0" y="1181.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="p3l" value="Mark approved" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1025.0" y="1264.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p3m" value="Checking every 2 s: gets a one-time token, enrols, signed with the device key" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="525.0" y="1364.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p3n" value="Bind the PC to the account as admin. Save the PC&amp;#x27;s name and shared folder names" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1025.0" y="1464.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p3n2" value="PC, owner, folder names" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1280.0" y="1468.0" width="190" height="56" as="geometry"/></mxCell><mxCell id="p3o" value="Keeps one connection open to the server, so no router setup is needed" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="525.0" y="1564.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p3p" value="&amp;#x27;This PC belongs to the account at …&amp;#x27;" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="275.0" y="1664.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p3q" value="After Refresh: the card says &amp;#x27;You manage it&amp;#x27;&lt;br&gt;&lt;b&gt;(#174)&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1525.0" y="1764.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p3r" value="" style="ellipse;shape=doubleEllipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="110.0" y="1881.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="p3x" value="A PC with no screen: &amp;#x27;agent login&amp;#x27; prints the link and code. Approve from a phone&amp;#x27;s browser" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="275.0" y="1961.0" width="200" height="70" as="geometry"/></mxCell><mxCell id="p3e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p3a" target="p3b"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p3b" target="p3c"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p3c" target="p3d"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p3d" target="p3e"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p3e" target="p3f"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3e5" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p3f" target="p3j"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3e6" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p3f" target="p3g"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3e7" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p3g" target="p3i"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3e8" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p3g" target="p3h"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p3h" target="p3i"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p3i" target="p3j"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3e11" value="Refuse" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p3j" target="p3k"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p3k" target="p3k2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p3k2" target="p3k3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3e14" value="Approve" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p3j" target="p3l"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p3l" target="p3m"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p3m" target="p3n"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p3n" target="p3o"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p3o" target="p3p"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p3p" target="p3q"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p3q" target="p3r"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="p3n" target="p3n2"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="5 Open files over the internet" id="d6"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p4t" value="&lt;b&gt;5. Open files over the internet&lt;/b&gt;&lt;br&gt;The same file browser as on the Wi-Fi. The app picks the path; the person only sees the label." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="580" height="90" as="geometry"/></mxCell><mxCell id="p4lg" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;White: built today&lt;br&gt;Yellow: in a GitHub issue (#number)&lt;br&gt;Red: GAP, no issue yet&lt;br&gt;Blue: data kept or email sent" style="rounded=1;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="600" y="0" width="400" height="90" as="geometry"/></mxCell><mxCell id="p4lh0" value="&lt;b&gt;Person&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="0" y="110" width="250" height="36" as="geometry"/></mxCell><mxCell id="p4lb0" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="0" y="146" width="250" height="1380" as="geometry"/></mxCell><mxCell id="p4lh1" value="&lt;b&gt;App (phone or laptop)&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="250" y="110" width="250" height="36" as="geometry"/></mxCell><mxCell id="p4lb1" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="250" y="146" width="250" height="1380" as="geometry"/></mxCell><mxCell id="p4lh2" value="&lt;b&gt;Server&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="500" y="110" width="250" height="36" as="geometry"/></mxCell><mxCell id="p4lb2" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="500" y="146" width="250" height="1380" as="geometry"/></mxCell><mxCell id="p4lh3" value="&lt;b&gt;Agent (background, on the PC)&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="750" y="110" width="250" height="36" as="geometry"/></mxCell><mxCell id="p4lb3" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="750" y="146" width="250" height="1380" as="geometry"/></mxCell><mxCell id="p4a" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="110.0" y="181.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="p4b" value="Tap a folder tile on a PC&amp;#x27;s card" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="25.0" y="264.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p4c" value="PC on this Wi-Fi and proved its key?" style="rhombus;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="280.0" y="354.0" width="190" height="84" as="geometry"/></mxCell><mxCell id="p4d" value="Open directly. Label: &amp;#x27;On your Wi-Fi&amp;#x27; (flow 2)" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="275.0" y="464.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p4d2" value="" style="ellipse;shape=doubleEllipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="110.0" y="481.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="p4e" value="Server says the PC is connected?" style="rhombus;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="280.0" y="554.0" width="190" height="84" as="geometry"/></mxCell><mxCell id="p4f" value="&amp;#x27;Can&amp;#x27;t reach right now&amp;#x27;. Tiles disabled, no spinner&lt;br&gt;&lt;b&gt;(#174)&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="275.0" y="664.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p4f2" value="" style="ellipse;shape=doubleEllipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="110.0" y="681.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="p4g" value="File browser, label &amp;#x27;Over the internet&amp;#x27;. Sends the session with each request&lt;br&gt;&lt;b&gt;(#103)&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="275.0" y="764.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p4h" value="Session valid, still has access, folder exists, owner&amp;#x27;s subscription on, PC connected?" style="rhombus;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="530.0" y="854.0" width="190" height="84" as="geometry"/></mxCell><mxCell id="p4i" value="One plain message: can&amp;#x27;t reach / no longer have access / subscription not active / sign in again&lt;br&gt;&lt;b&gt;(#103)&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="275.0" y="964.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p4i2" value="" style="ellipse;shape=doubleEllipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="110.0" y="981.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="p4j" value="Forward the request down the PC&amp;#x27;s connection" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="525.0" y="1064.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p4k" value="Serves the files, the same way as on the Wi-Fi" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="775.0" y="1164.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p4l" value="List, save, send, delete" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="275.0" y="1264.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p4m" value="" style="ellipse;shape=doubleEllipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="110.0" y="1381.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="p4e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p4a" target="p4b"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p4b" target="p4c"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4e2" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p4c" target="p4d"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p4d" target="p4d2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4e4" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p4c" target="p4e"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4e5" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p4e" target="p4f"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p4f" target="p4f2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4e7" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p4e" target="p4g"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p4g" target="p4h"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4e9" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p4h" target="p4i"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p4i" target="p4i2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4e11" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p4h" target="p4j"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p4j" target="p4k"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p4k" target="p4l"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p4l" target="p4m"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="6 Invite someone to a PC, and join with a code" id="d7"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p5t" value="&lt;b&gt;6. Invite someone to a PC, and join with a code&lt;/b&gt;&lt;br&gt;An admin of a PC lets another person reach it. The code works once and is shown once." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1330" height="90" as="geometry"/></mxCell><mxCell id="p5lg" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;White: built today&lt;br&gt;Yellow: in a GitHub issue (#number)&lt;br&gt;Red: GAP, no issue yet&lt;br&gt;Blue: data kept or email sent" style="rounded=1;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1350" y="0" width="400" height="90" as="geometry"/></mxCell><mxCell id="p5lh0" value="&lt;b&gt;Admin&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="0" y="110" width="250" height="36" as="geometry"/></mxCell><mxCell id="p5lb0" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="0" y="146" width="250" height="1780" as="geometry"/></mxCell><mxCell id="p5lh1" value="&lt;b&gt;Admin&amp;#x27;s app&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="250" y="110" width="250" height="36" as="geometry"/></mxCell><mxCell id="p5lb1" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="250" y="146" width="250" height="1780" as="geometry"/></mxCell><mxCell id="p5lh2" value="&lt;b&gt;Server&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="500" y="110" width="250" height="36" as="geometry"/></mxCell><mxCell id="p5lb2" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="500" y="146" width="250" height="1780" as="geometry"/></mxCell><mxCell id="p5lh3" value="&lt;b&gt;Database and email&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="750" y="110" width="250" height="36" as="geometry"/></mxCell><mxCell id="p5lb3" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="750" y="146" width="250" height="1780" as="geometry"/></mxCell><mxCell id="p5lh4" value="&lt;b&gt;Website (browser)&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="110" width="250" height="36" as="geometry"/></mxCell><mxCell id="p5lb4" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="146" width="250" height="1780" as="geometry"/></mxCell><mxCell id="p5lh5" value="&lt;b&gt;Guest&amp;#x27;s app&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1250" y="110" width="250" height="36" as="geometry"/></mxCell><mxCell id="p5lb5" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1250" y="146" width="250" height="1780" as="geometry"/></mxCell><mxCell id="p5lh6" value="&lt;b&gt;Guest&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1500" y="110" width="250" height="36" as="geometry"/></mxCell><mxCell id="p5lb6" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1500" y="146" width="250" height="1780" as="geometry"/></mxCell><mxCell id="p5a" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="110.0" y="181.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="p5b" value="&amp;#x27;Manage&amp;#x27; on the PC&amp;#x27;s card&lt;br&gt;&lt;b&gt;(#174)&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="275.0" y="264.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p5c" value="Invite: Guest or Admin, 1 hour / 1 day / 7 days, &amp;#x27;Make a code&amp;#x27;" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="275.0" y="364.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p5d" value="Make the code, keep only its hash" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="525.0" y="464.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p5e" value="Show the code once, &amp;#x27;Share&amp;#x27; (Android share sheet, or copy on desktop)" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="275.0" y="564.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p5f" value="Send the message in any chat or email app" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="25.0" y="664.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p5g" value="Receives the message" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1525.0" y="764.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p5h" value="Has the app?" style="rhombus;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1530.0" y="854.0" width="190" height="84" as="geometry"/></mxCell><mxCell id="p5i" value="The message links to the download page and drops the server address&lt;br&gt;&lt;b&gt;(#187)&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1025.0" y="964.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="p5j" value="Has an account?" style="rhombus;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1530.0" y="1054.0" width="190" height="84" as="geometry"/></mxCell><mxCell id="p5k" value="Make an account (flow 3)" style="rounded=1;html=1;whiteSpace=wrap;fontSi