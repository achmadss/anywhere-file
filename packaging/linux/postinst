#!/bin/sh
# Runs as root after dpkg unpacks the files. The service is the user's own, so this drops
# to whoever asked for the install. A machine installed from a root shell is told what to
# run instead, because there is no way to guess whose PC it is.
set -e

dest=/usr/lib/anywhere-file
user=${SUDO_USER:-}
if [ -z "$user" ] && [ -n "${PKEXEC_UID:-}" ]; then
	user=$(id -un "$PKEXEC_UID" 2>/dev/null || true)
fi

if [ -z "$user" ] || [ "$user" = root ]; then
	echo "install the service as your own user: anywhere-file-agent install"
else
	set --
	if [ -f "$dest/agent.env" ]; then
		while IFS= read -r line; do
			case "$line" in RFM_AGENT_*=*) set -- "$@" "$line" ;; esac
		done <"$dest/agent.env"
	fi
	uid=$(id -u "$user")
	# systemctl --user needs to be told where that user's manager listens, and root's
	# environment does not have it.
	runuser -u "$user" -- env XDG_RUNTIME_DIR="/run/user/$uid" "$dest/agent" install "$@" ||
		echo "could not install the service for $user. Run: anywhere-file-agent install"

	# #185: open the settings page in the user's desktop. Root's environment says nothing
	# about that desktop, and the user's systemd manager has it once a session started.
	# Nothing opens when there is no display, or for apt run with no questions asked.
	display=$(runuser -u "$user" -- env XDG_RUNTIME_DIR="/run/user/$uid" systemctl --user show-environment 2>/dev/null |
		grep -E '^(DISPLAY|WAYLAND_DISPLAY|XAUTHORITY|DBUS_SESSION_BUS_ADDRESS)=' || true)
	if [ "${DEBIAN_FRONTEND:-}" != noninteractive ] && echo "$display" | grep -qE '^(DISPLAY|WAYLAND_DISPLAY)='; then
		# shellcheck disable=SC2086 # one VAR=value per word
		runuser -u "$user" -- env XDG_RUNTIME_DIR="/run/user/$uid" $display "$dest/agent" settings >/dev/null 2>&1 || true
	else
		echo "open the settings page with: anywhere-file-agent settings"
	fi
fi

# The service file is now on disk. firewalld only reads it after a reload, and opening the
# port is left to whoever runs the machine: firewall-cmd --permanent --add-service=anywhere-file
if command -v firewall-cmd >/dev/null 2>&1 && firewall-cmd --state >/dev/null 2>&1; then
	firewall-cmd --reload >/dev/null || true
fi
