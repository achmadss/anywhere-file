#!/bin/sh
# Stops the service before the files go. Uninstalling something that was never installed,
# or that belongs to a user who is not here, is not a failure. A removal signs the PC out
# first (#189). An upgrade runs this too, with "upgrade", and keeps the account (#190).
set -e

action=${1:-}
user=${SUDO_USER:-}
# A software centre removes the package through pkexec, which sets PKEXEC_UID (#223).
if [ -z "$user" ] && [ -n "${PKEXEC_UID:-}" ]; then
	user=$(id -un "$PKEXEC_UID" 2>/dev/null || true)
fi
if [ -n "$user" ] && [ "$user" != root ]; then
	uid=$(id -u "$user" 2>/dev/null || echo)
	if [ -n "$uid" ]; then
		as_user() {
			runuser -u "$user" -- env XDG_RUNTIME_DIR="/run/user/$uid" /usr/lib/anywhere-file/agent "$@"
		}
		if [ "$action" = remove ]; then
			as_user logout || echo "could not sign this PC out of its account, so remove it in the app"
		fi
		as_user uninstall || true
	fi
fi
exit 0
