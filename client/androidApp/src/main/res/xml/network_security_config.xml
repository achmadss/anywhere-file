<?xml version="1.0" encoding="utf-8"?>
<!-- The only plain HTTP this app is allowed is the relay it is holding the other end of
     itself (#99). Everything that leaves the phone stays on TLS. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
