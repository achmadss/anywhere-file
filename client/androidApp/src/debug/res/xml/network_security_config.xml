<?xml version="1.0" encoding="utf-8"?>
<!--
  The debug build may reach a control plane running on the machine this app is being
  developed on. That server is plain HTTP: there is no certificate authority to sign a
  certificate for it, and the client checks the platform's trust store the way any app does.
  Over plain HTTP the session token would be readable by anything on the same network, so the
  exception is limited to the addresses a development server is reached at, and to debug
  builds only. Release builds keep the platform default, which refuses cleartext outright.

  10.0.2.2 is how the emulator reaches the host machine. 127.0.0.1 is for a server on a phone
  that is running one itself, and localhost for completeness.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
