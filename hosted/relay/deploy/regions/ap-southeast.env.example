# AP Southeast region. Copy to ap-southeast.env, fill in the operator values,
# never commit the filled copy. Render with:
#   ./render-config.sh regions/ap-southeast.env > /etc/iroh-relay/relay.toml

# Public DNS name of this relay. One hostname per region, port 443.
RELAY_HOSTNAME=relay-ap-southeast.example.com
# Contact for LetsEncrypt expiry and policy notices. Must be a real address.
RELAY_CONTACT=ops@example.com
# Private (VPC) address and port for Prometheus scraping. Never 0.0.0.0.
# Scraped from the monitoring subnet only. See provision.sh.
METRICS_BIND_ADDR=10.0.2.5:9090
# Accept-queue DoS protection (connections per second, sustained and burst).
ACCEPT_CONN_LIMIT=50
ACCEPT_CONN_BURST=100
# Per-client receive-side DoS protection (bytes per second, sustained and burst).
# r3 section 11.3 defaults. Sustained rate, not a quota.
CLIENT_RX_BYTES_PER_SECOND=4000000
CLIENT_RX_MAX_BURST_BYTES=8000000
# Tag for the built image.
IMAGE_TAG=local
