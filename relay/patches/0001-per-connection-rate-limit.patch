+                SLOW_BPS
+            } else if endpoint_id == fast_key {
+                FAST_BPS
+            } else {
+                // Admitted with no rate of its own: stays on the server-wide limit.
+                return Access::Allow;
+            };
+            Access::AllowLimited {
+                rate_limit: ClientRateLimit::new(NonZeroU32::new(rate).expect("non-zero")),
+            }
+        })));
