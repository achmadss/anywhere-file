+            registry
+                .connection_rate_limit(id)
+                .map(|r| r.bytes_per_second.get())
+        };
+
+        // The access decision reached each connection, and each got its own rate.
+        assert_eq!(bps(slow_key), Some(SLOW_BPS));
+        assert_eq!(bps(fast_key), Some(FAST_BPS));
+        assert_eq!(
+            bps(unlimited_key),
+            None,
+            "plain Allow means the server-wide limit"
+        );
+
+        // A server-wide change reaches only the connection without a rate of its own.
+        const SERVER_WIDE_BPS: u32 = 500_000;
+        server
+            .relay_service()
+            .expect("relay service running")
+            .set_client_rate_limit(Some(ClientRateLimit::new(
+                NonZeroU32::new(SERVER_WIDE_BPS).unwrap(),
+            )));
+        assert_eq!(bps(unlimited_key), Some(SERVER_WIDE_BPS));
+        assert_eq!(
+            bps(slow_key),
+            Some(SLOW_BPS),
+            "an overridden connection ignores it"
+        );
+        assert_eq!(
+            bps(fast_key),
+            Some(FAST_BPS),
+            "an overridden connection ignores it"
+        );
+
+        // A tier change retargets one live connection and leaves the others alone.
+        assert!(registry.set_connection_rate_limit(
+            slow_key,
+            Some(ClientRateLimit::new(NonZeroU32::new(FAST_BPS).unwrap()))
+        ));
+        assert_eq!(bps(slow_key), Some(FAST_BPS));
+        assert_eq!(bps(fast_key), Some(FAST_BPS));
+        assert_eq!(bps(unlimited_key), Some(SERVER_WIDE_BPS));
+
+        // Pinning the previously unlimited connection stops server-wide changes reaching it.
+        assert!(registry.set_connection_rate_limit(
+            unlimited_key,
+            Some(ClientRateLimit::new(NonZeroU32::new(SLOW_BPS).unwrap()))
+        ));
+        server
+            .relay_service()
+            .expect("relay service running")
+            .set_client_rate_limit(None);
+        assert_eq!(bps(unlimited_key), Some(SLOW_BPS));
+
+        // An endpoint that was never admitted has nothing to retarget.
+        let stranger = SecretKey::from_bytes(&rng.random()).public();
+        assert!(!registry.set_connection_rate_limit(stranger, None));
+
